{
	// make sure the settings below is not present in either user and
	// workspace settings so adding ids to messages on save works
	// "eslint.codeActionsOnSave.rules": [],
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"typescript.tsdk": "node_modules/typescript/lib",
	"eslint.run": "onSave",
	"editor.codeActionsOnSave": {
		"source.fixAll": "always"
	},
	"tailwindCSS.classAttributes": ["className", "clsx"],
	"css.validate": true,
	"editor.quickSuggestions": {
		"strings": true
	},
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"workbench.colorCustomizations": {
		"activityBar.activeBackground": "#1a1a1a",
		"activityBar.background": "#1a1a1a",
		"activityBar.foreground": "#e7e7e7",
		"activityBar.inactiveForeground": "#e7e7e799",
		"activityBarBadge.background": "#606020",
		"activityBarBadge.foreground": "#e7e7e7",
		"commandCenter.border": "#e7e7e799",
		"sash.hoverBorder": "#1a1a1a",
		"statusBar.background": "#000000",
		"statusBar.foreground": "#e7e7e7",
		"statusBarItem.hoverBackground": "#1a1a1a",
		"statusBarItem.remoteBackground": "#000000",
		"statusBarItem.remoteForeground": "#e7e7e7",
		"titleBar.activeBackground": "#000000",
		"titleBar.activeForeground": "#e7e7e7",
		"titleBar.inactiveBackground": "#00000099",
		"titleBar.inactiveForeground": "#e7e7e799"
	},
	"peacock.color": "#000000"
}
